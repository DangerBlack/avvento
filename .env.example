# copia in .env accanto a docker-compose.yml
# 0 = le pagine di stampa non esistono (consigliato se il sito è pubblico)
AVVENTO_STAMPA=1
AVVENTO_STAMPA_PAROLA=cambiami

# chiave d'accesso al sito: senza, chiunque conosca l'indirizzo entra
# genera con: node -e "console.log(crypto.randomUUID())"
AVVENTO_CHIAVE=
